---
const newsLinks = [
  { href: "#top", label: "Hurto a repartidores: cifras oficiales" },
  { href: "#top", label: "Localidades con más reportes de noche" },
  { href: "#top", label: "Guía: qué hacer si te roban en plena entrega" },
];

const navLinks = [
  { href: "#reto", label: "El reto" },
  { href: "#solucion", label: "Nuestra solución" },
  { href: "#equipo", label: "Equipo creador" },
  { href: "#registro", label: "Registro" },
];
---

<footer class="site-footer">
  <div class="container">
    <div class="grid">
      <div class="brand-col">
        <div class="brand">
          <span class="brand-mark" aria-hidden="true">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none">
              <path
                d="M12 21s7-6.1 7-11a7 7 0 1 0-14 0c0 4.9 7 11 7 11Z"
                stroke="#fff"
                stroke-width="2"
                stroke-linejoin="round"></path>
            </svg>
          </span>
          <span class="brand-name">UrbanSafe</span>
        </div>
        <p>Proyecto académico de seguridad colaborativa para domiciliarios de Bogotá.</p>
        <div class="social-row">
          <a href="#top" aria-label="Instagram" class="social">
            <svg width="19" height="19" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <rect x="3.5" y="3.5" width="17" height="17" rx="5" stroke="currentColor" stroke-width="1.9"></rect>
              <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.9"></circle>
              <circle cx="17" cy="7" r="1.2" fill="currentColor"></circle>
            </svg>
          </a>
          <a href="#top" aria-label="TikTok" class="social">
            <svg width="19" height="19" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path
                d="M14 3.5v10.9a3.4 3.4 0 1 1-3.4-3.4"
                stroke="currentColor"
                stroke-width="1.9"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
              <path d="M14 3.5c.4 2.4 2 3.9 4.4 4.1" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"
              ></path>
            </svg>
          </a>
          <a href="#top" aria-label="WhatsApp" class="social">
            <svg width="19" height="19" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path
                d="M20.5 12a8.5 8.5 0 0 1-12.6 7.4L3.5 20.5l1.2-4.3A8.5 8.5 0 1 1 20.5 12Z"
                stroke="currentColor"
                stroke-width="1.9"
                stroke-linejoin="round"></path>
            </svg>
          </a>
        </div>
      </div>

      <div class="col">
        <strong class="eyebrow">NOTICIAS DE SEGURIDAD</strong>
        {newsLinks.map((link) => <a href={link.href}>{link.label}</a>)}
      </div>

      <div class="col">
        <strong class="eyebrow">NAVEGACIÓN</strong>
        {navLinks.map((link) => <a href={link.href}>{link.label}</a>)}
      </div>

      <div class="col">
        <strong class="eyebrow">VISITANTES</strong>
        <div class="odometer" data-counter data-target="12480" data-pad="5" role="img" aria-label="12480 visitas">
          <span class="digit" aria-hidden="true">1</span>
          <span class="digit" aria-hidden="true">2</span>
          <span class="digit" aria-hidden="true">4</span>
          <span class="digit" aria-hidden="true">8</span>
          <span class="digit" aria-hidden="true">0</span>
        </div>
        <span class="visitors-label">
          <span class="dot" aria-hidden="true"></span>
          Han visto el proyecto
        </span>
      </div>
    </div>

    <div class="bottom">
      <span>© 2026 UrbanSafe · Proyecto académico, Bogotá D.C.</span>
      <span>Hecho por y para quienes ruedan la ciudad.</span>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-ink);
    color: var(--color-bg);
    border-radius: 36px 36px 0 0;
    padding: 46px 0 30px;
  }

  .grid {
    display: grid;
    gap: 26px;
    grid-template-columns: repeat(auto-fit, minmax(215px, 1fr));
    margin-bottom: 30px;
  }

  .brand-col {
    display: grid;
    gap: 12px;
    align-content: start;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .brand-mark {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--color-accent);
    display: grid;
    place-items: center;
  }

  .brand-name {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 19px;
  }

  .brand-col p {
    margin: 0;
    font-size: 15px;
    line-height: 1.6;
    color: var(--color-subtle);
    max-width: 30ch;
  }

  .social-row {
    display: flex;
    gap: 9px;
    margin-top: 4px;
  }

  .social {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: rgba(248, 250, 252, 0.08);
    display: grid;
    place-items: center;
    color: var(--color-bg);
  }

  .social:hover {
    background: var(--color-accent);
    color: var(--color-bg);
  }

  .col {
    display: grid;
    gap: 9px;
    align-content: start;
  }

  .eyebrow {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 1.3px;
    color: var(--color-accent-light);
  }

  .col a {
    font-size: 15px;
    line-height: 1.45;
    color: #cbd5e1;
    padding: 6px 0;
    min-height: 44px;
    display: flex;
    align-items: center;
  }

  .col a:hover {
    color: var(--color-bg);
  }

  .odometer {
    display: flex;
    gap: 5px;
    margin-top: 1px;
  }

  .digit {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 22px;
    color: var(--color-bg);
    background: rgba(248, 250, 252, 0.08);
    border-radius: 14px;
    padding: 9px 10px;
    min-width: 34px;
    text-align: center;
    font-variant-numeric: tabular-nums;
  }

  .visitors-label {
    font-size: 13.5px;
    color: var(--color-subtle);
    display: flex;
    align-items: center;
    gap: 7px;
  }

  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-success);
  }

  .bottom {
    border-top: 1px solid rgba(248, 250, 252, 0.12);
    padding-top: 18px;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    justify-content: space-between;
    font-size: 13.5px;
    color: var(--color-subtle);
  }

  @media (prefers-reduced-motion: no-preference) {
    .dot {
      animation: blink 1.7s ease-in-out infinite;
    }
  }
</style>

<script>
  const odometer = document.querySelector<HTMLElement>(".odometer[data-counter]");
  const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  function animateOdometer(entries: IntersectionObserverEntry[], observer: IntersectionObserver) {
    entries.forEach((entry) => {
      if (!entry.isIntersecting) return;
      const el = entry.target as HTMLElement;
      const target = Number(el.dataset.target ?? "0");
      const pad = Number(el.dataset.pad ?? "5");
      const digitEls = el.querySelectorAll<HTMLElement>(".digit");
      observer.unobserve(el);

      if (prefersReducedMotion) return;

      const duration = 1400;

      digitEls.forEach((digitEl) => {
        digitEl.textContent = "0";
      });
      const start = performance.now();

      const step = (now: number) => {
        const progress = Math.min(1, (now - start) / duration);
        const eased = 1 - Math.pow(1 - progress, 3);
        const value = String(Math.round(target * eased)).padStart(pad, "0").split("");
        digitEls.forEach((digitEl, i) => {
          digitEl.textContent = value[i] ?? "0";
        });
        if (progress < 1) requestAnimationFrame(step);
      };

      requestAnimationFrame(step);
    });
  }

  if (odometer) {
    const observer = new IntersectionObserver(animateOdometer, { threshold: 0.4 });
    observer.observe(odometer);
  }
</script>
