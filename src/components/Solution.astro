---
const stages = [
  {
    moment: "Antes de aceptar el pedido",
    iconBg: "rgba(16,185,129,.14)",
    iconColor: "var(--color-success-dark)",
    lineColor: "var(--color-success)",
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M12 21s7-6.1 7-11a7 7 0 1 0-14 0c0 4.9 7 11 7 11Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><circle cx="12" cy="10" r="2.6" fill="currentColor"/></svg>`,
    title: "Mapa en tiempo real",
    body: "Cada barrio en verde, amarillo o rojo según los reportes de las últimas horas y la franja en la que estás rodando.",
  },
  {
    moment: "En plena ruta",
    iconBg: "rgba(251,191,36,.18)",
    iconColor: "var(--color-warning-dark)",
    lineColor: "var(--color-warning)",
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M18 15V10.5a6 6 0 1 0-12 0V15l-1.6 2.4h15.2L18 15Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="M10 20.2a2.2 2.2 0 0 0 4 0" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>`,
    title: "Alertas predictivas",
    body: "Una vibración y un aviso claro antes de entrar a una zona caliente, con la ruta alterna sugerida para no perder el domicilio.",
  },
  {
    moment: "Cuando ves algo raro",
    iconBg: "rgba(234,88,12,.14)",
    iconColor: "var(--color-accent-dark)",
    lineColor: "var(--color-accent)",
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none"><circle cx="9" cy="9" r="3.2" stroke="currentColor" stroke-width="2"/><path d="M3.2 19.4c.5-3 3-4.7 5.8-4.7s5.3 1.7 5.8 4.7" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path d="M16.4 5.6a3 3 0 0 1 0 6M18 14.9c2.1.5 3.4 2.1 3.7 4.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>`,
    title: "Red colaborativa",
    body: "Reportas en dos toques y avisas a todos los que ruedan cerca. Lo que hoy se pierde en un chat queda en el mapa.",
  },
];
---

<section id="solucion" class="solution">
  <div class="container">
    <div class="intro">
      <h2 class="reveal">Tres herramientas para llegar y volver bien</h2>
    </div>

    <div class="journey">
      <div class="journey-line" aria-hidden="true"></div>
      {
        stages.map((stage, index) => (
          <div class="stage reveal" style={`--reveal-delay: ${index * 110}ms`}>
            <span class="stage-marker" style={`background:${stage.iconBg}; color:${stage.iconColor}`} set:html={stage.icon} />
            <div class="stage-body">
              <span class="stage-moment">{stage.moment}</span>
              <h3>{stage.title}</h3>
              <p>{stage.body}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .solution {
    padding: 54px 0;
  }

  .intro {
    display: grid;
    gap: 14px;
    max-width: 52ch;
    margin-bottom: 44px;
  }

  h2 {
    font-weight: 800;
    font-size: clamp(28px, 6.6vw, 44px);
    line-height: 1.1;
    letter-spacing: -1.4px;
    margin: 0;
  }

  .journey {
    position: relative;
    display: grid;
    gap: 40px;
    padding-left: 76px;
  }

  .journey-line {
    position: absolute;
    left: 27px;
    top: 28px;
    bottom: 28px;
    width: 2px;
    background: repeating-linear-gradient(
      to bottom,
      var(--color-border) 0,
      var(--color-border) 6px,
      transparent 6px,
      transparent 12px
    );
  }

  .stage {
    position: relative;
    display: grid;
    gap: 6px;
  }

  .stage-marker {
    position: absolute;
    left: -76px;
    top: 0;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    display: grid;
    place-items: center;
  }

  .stage-moment {
    font-size: 13.5px;
    font-weight: 500;
    color: var(--color-muted-2);
  }

  h3 {
    font-weight: 700;
    font-size: 22px;
    margin: 0;
    letter-spacing: -0.5px;
  }

  .stage-body p {
    margin: 4px 0 0;
    font-size: 16px;
    line-height: 1.6;
    color: var(--color-muted);
    max-width: 52ch;
  }

  @media (max-width: 480px) {
    .journey {
      padding-left: 60px;
      gap: 34px;
    }

    .journey-line {
      left: 21px;
    }

    .stage-marker {
      left: -60px;
      width: 44px;
      height: 44px;
    }

    .stage-marker svg {
      width: 20px;
      height: 20px;
    }
  }
</style>
