---
---

<section id="top" class="hero">
  <div class="container grid">
    <div class="copy">
      <h1 class="reveal">Rutas y zonas de entrega <span class="accent">seguras</span> en tiempo real para domiciliarios en Bogotá.</h1>

      <p class="lede reveal" style="--reveal-delay: 90ms">
        Mira el riesgo de cada barrio antes de aceptar el pedido, recibe alertas antes de entrar a una zona caliente y llega con una ruta alterna lista.
      </p>

      <a href="/#registro" class="primary-cta reveal" style="--reveal-delay: 180ms">
        Registrarme gratis
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path
            d="M4 12h15m0 0-6-6m6 6-6 6"
            stroke="#fff"
            stroke-width="2.4"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </a>
    </div>

    <div class="map-wrap">
      <div class="map">
        <div class="glow" aria-hidden="true"></div>
        <div class="map-card">
          <div class="route-tag">
            <span>Kennedy → P. Aranda</span>
            <span class="eta">18 min</span>
          </div>

          <svg class="network" viewBox="0 0 380 400" fill="none" aria-hidden="true">
            <defs>
              <radialGradient id="glow-danger" cx="50%" cy="50%" r="50%">
                <stop offset="0%" stop-color="var(--color-danger)" stop-opacity="0.55" />
                <stop offset="100%" stop-color="var(--color-danger)" stop-opacity="0" />
              </radialGradient>
              <radialGradient id="glow-warning" cx="50%" cy="50%" r="50%">
                <stop offset="0%" stop-color="var(--color-warning)" stop-opacity="0.5" />
                <stop offset="100%" stop-color="var(--color-warning)" stop-opacity="0" />
              </radialGradient>
              <radialGradient id="glow-safe" cx="50%" cy="50%" r="50%">
                <stop offset="0%" stop-color="var(--color-success)" stop-opacity="0.45" />
                <stop offset="100%" stop-color="var(--color-success)" stop-opacity="0" />
              </radialGradient>
            </defs>

            <g class="grid-dots" aria-hidden="true">
              {Array.from({ length: 10 }).map((_, row) =>
                Array.from({ length: 10 }).map((_, col) => (
                  <circle cx={20 + col * 38} cy={20 + row * 38} r="1.4" fill="#94a3b8" fill-opacity="0.22" />
                ))
              )}
            </g>

            <circle cx="58" cy="252" r="66" fill="url(#glow-danger)" />
            <circle cx="232" cy="150" r="56" fill="url(#glow-warning)" />
            <circle cx="112" cy="312" r="52" fill="url(#glow-safe)" />

            <path
              class="route route-risky"
              d="M58,252 L232,150 L222,280"
              stroke="#64748b"
              stroke-width="2"
              stroke-dasharray="2 8"
              stroke-linecap="round"
            />
            <path
              class="route route-safe"
              d="M58,252 L112,312 L222,280"
              stroke="var(--color-accent)"
              stroke-width="3.5"
              stroke-dasharray="9 7"
              stroke-linecap="round"
            />

            <line x1="64" y1="72" x2="302" y2="62" stroke="#94a3b8" stroke-width="1.5" stroke-dasharray="2 7" stroke-opacity="0.5" />
            <line x1="302" y1="62" x2="232" y2="150" stroke="#94a3b8" stroke-width="1.5" stroke-dasharray="2 7" stroke-opacity="0.5" />

            <circle cx="64" cy="72" r="4" fill="var(--color-success)" fill-opacity="0.7" />
            <circle cx="302" cy="62" r="4" fill="var(--color-success)" fill-opacity="0.7" />

            <circle class="node node-warning" cx="232" cy="150" r="7" fill="var(--color-warning)" />
            <text class="label" x="232" y="132">Chapinero</text>

            <circle class="node node-safe" cx="112" cy="312" r="7" fill="var(--color-success)" />
            <text class="label" x="112" y="334">Bosa</text>

            <circle class="node node-warning" cx="222" cy="280" r="7" fill="var(--color-warning)" />
            <text class="label" x="222" y="262">P. Aranda</text>

            <g class="node-danger-group">
              <circle class="node-ping" cx="58" cy="252" r="8" fill="var(--color-danger)" />
              <circle class="node node-danger" cx="58" cy="252" r="8" fill="var(--color-danger)" />
            </g>
            <text class="label" x="58" y="234">Kennedy</text>
          </svg>

          <div class="legend">
            <span class="legend-item legend-safe">Segura</span>
            <span class="legend-item legend-warning">Precaución</span>
            <span class="legend-item legend-danger">Peligro</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding: 34px 0 54px;
  }

  .grid {
    display: grid;
    gap: 40px;
    grid-template-columns: repeat(auto-fit, minmax(min(330px, 100%), 1fr));
    align-items: center;
  }

  .copy {
    display: grid;
    gap: 22px;
    justify-items: start;
  }

  h1 {
    font-weight: 800;
    font-size: clamp(34px, 8.6vw, 60px);
    line-height: 1.04;
    letter-spacing: -2px;
    margin: 0;
    max-width: 17ch;
  }

  .accent {
    color: var(--color-accent);
  }

  .lede {
    margin: 0;
    font-size: clamp(17px, 4.4vw, 20px);
    line-height: 1.6;
    color: var(--color-muted);
    max-width: 46ch;
  }

  .primary-cta {
    width: 100%;
    max-width: 400px;
    background: var(--color-accent);
    color: #fff;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(19px, 5vw, 23px);
    letter-spacing: -0.3px;
    padding: 22px 30px;
    border-radius: 999px;
    min-height: 68px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    box-shadow: var(--shadow-accent-lg);
  }

  .primary-cta svg {
    transition: transform var(--transition);
  }

  .primary-cta:hover {
    background: var(--color-accent-dark);
    color: #fff;
    box-shadow: 0 22px 46px rgba(194, 65, 12, 0.5);
  }

  .primary-cta:hover svg {
    transform: translateX(4px);
  }

  .primary-cta:active {
    transform: translateY(2px) scale(0.99);
    box-shadow: var(--shadow-accent);
  }

  .map-wrap {
    display: grid;
    justify-items: center;
  }

  .map {
    position: relative;
    width: min(400px, 88vw);
  }

  .glow {
    position: absolute;
    inset: -22px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(234, 88, 12, 0.22) 0%, rgba(234, 88, 12, 0.05) 55%, transparent 72%);
  }

  .map-card {
    position: relative;
    aspect-ratio: 380 / 400;
    border-radius: 32px;
    background: radial-gradient(120% 90% at 30% 12%, #1d2d4a 0%, #16233b 55%, #101a2d 100%);
    box-shadow: 0 30px 60px rgba(15, 23, 42, 0.3);
    overflow: hidden;
  }

  .route-tag {
    position: absolute;
    z-index: 1;
    top: 14px;
    left: 12px;
    right: 12px;
    background: rgba(248, 250, 252, 0.96);
    border-radius: 18px;
    padding: 12px 14px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    box-shadow: 0 8px 20px rgba(2, 6, 23, 0.28);
    font-family: var(--font-display);
    font-size: 13px;
    font-weight: 700;
    color: var(--color-ink);
  }

  .eta {
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 700;
    color: var(--color-danger-dark);
    background: var(--color-danger-bg);
    border-radius: 999px;
    padding: 5px 10px;
  }

  .network {
    display: block;
    width: 100%;
    height: 100%;
  }

  .route-risky {
    opacity: 0.6;
  }

  .node-ping {
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
  }

  .label {
    font-family: var(--font-display);
    font-size: 13px;
    font-weight: 700;
    fill: #f8fafc;
    text-anchor: middle;
  }

  .legend {
    position: absolute;
    z-index: 1;
    bottom: 16px;
    left: 12px;
    right: 12px;
    display: flex;
    gap: 6px;
  }

  .legend-item {
    flex: 1;
    text-align: center;
    font-size: 11px;
    font-weight: 600;
    border-radius: 999px;
    padding: 8px 4px;
  }

  .legend-safe {
    color: #6ee7b7;
    background: rgba(16, 185, 129, 0.16);
  }

  .legend-warning {
    color: #fde68a;
    background: rgba(251, 191, 36, 0.16);
  }

  .legend-danger {
    color: #fca5a5;
    background: rgba(239, 68, 68, 0.18);
  }

  @media (prefers-reduced-motion: no-preference) {
    .map-card {
      animation: float 7s ease-in-out infinite;
    }

    .route-safe {
      animation: flow 1.1s linear infinite;
    }

    .node-ping {
      opacity: 0.8;
      animation: ping 2.1s ease-out infinite;
    }
  }
</style>
