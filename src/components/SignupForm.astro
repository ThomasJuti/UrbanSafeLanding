---
const localidades = [
  "Usaquén",
  "Chapinero",
  "Santa Fe",
  "San Cristóbal",
  "Usme",
  "Tunjuelito",
  "Bosa",
  "Kennedy",
  "Fontibón",
  "Engativá",
  "Suba",
  "Barrios Unidos",
  "Teusaquillo",
  "Los Mártires",
  "Antonio Nariño",
  "Puente Aranda",
  "La Candelaria",
  "Rafael Uribe Uribe",
  "Ciudad Bolívar",
  "Sumapaz",
];
---

<section id="registro" class="signup">
  <div class="container">
    <div class="panel">
      <div class="intro">
        <h2>Sé de los primeros en probar UrbanSafe</h2>
        <p>Déjanos tus datos y te escribimos cuando abramos el piloto en tu localidad.</p>
      </div>

      <div class="success-card" id="success-card" role="status" aria-live="polite" hidden>
        <span class="success-icon">
          <svg width="30" height="30" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path
              d="M20 6 9 17l-5-5"
              stroke="#059669"
              stroke-width="2.8"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </span>
        <strong>Quedaste en la lista</strong>
        <p id="success-message">Te avisamos en cuanto el piloto llegue a tu localidad.</p>
        <button type="button" id="reset-form">Registrar a otro compañero</button>
      </div>

      <form id="signup-form" class="form" novalidate>
        <label>
          <span>Nombre completo</span>
          <input type="text" name="name" placeholder="Ej. Camilo Rodríguez" autocomplete="name" />
        </label>

        <label>
          <span>Correo electrónico</span>
          <input type="email" name="email" placeholder="tucorreo@ejemplo.com" autocomplete="email" />
        </label>

        <label>
          <span>Localidad en Bogotá</span>
          <select name="zone">
            <option value="">Selecciona tu localidad</option>
            {localidades.map((zona) => <option value={zona}>{zona}</option>)}
          </select>
        </label>

        <p class="error" id="form-error" role="alert" aria-live="assertive" hidden></p>

        <button type="submit" class="submit">Registrarse</button>
        <p class="disclaimer">No compartimos tus datos. Solo te escribimos para el piloto.</p>
      </form>
    </div>
  </div>
</section>

<style>
  .signup {
    padding: 0 0 54px;
  }

  .panel {
    max-width: var(--max-width);
    margin: 0 auto;
    background: var(--color-accent-dark);
    border-radius: 36px;
    padding: clamp(30px, 6vw, 54px) clamp(20px, 5vw, 46px);
    display: grid;
    gap: 26px;
    justify-items: center;
  }

  .intro {
    display: grid;
    gap: 12px;
    text-align: center;
    justify-items: center;
    max-width: 40ch;
  }

  .intro h2 {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(28px, 7vw, 44px);
    line-height: 1.08;
    letter-spacing: -1.5px;
    margin: 0;
    color: #fff;
  }

  .intro p {
    margin: 0;
    font-size: 17.5px;
    line-height: 1.55;
    color: #fff;
  }

  .success-card {
    width: 100%;
    max-width: 560px;
    background: #fff;
    border-radius: 30px;
    padding: 34px 26px;
    display: grid;
    gap: 12px;
    justify-items: center;
    text-align: center;
    box-shadow: 0 22px 46px rgba(15, 23, 42, 0.22);
  }

  .success-card[hidden] {
    display: none;
  }

  .success-icon {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: rgba(16, 185, 129, 0.16);
    display: grid;
    place-items: center;
  }

  .success-card strong {
    font-family: var(--font-display);
    font-size: 24px;
    font-weight: 800;
    color: var(--color-ink);
    letter-spacing: -0.6px;
  }

  .success-card p {
    margin: 0;
    font-size: 16.5px;
    color: var(--color-muted);
    line-height: 1.55;
  }

  .success-card button {
    background: transparent;
    border: none;
    color: var(--color-accent-dark);
    font-weight: 700;
    font-size: 15px;
    cursor: pointer;
    min-height: 44px;
  }

  .form {
    width: 100%;
    max-width: 560px;
    background: #fff;
    border-radius: 30px;
    padding: 26px 24px;
    display: grid;
    gap: 16px;
    box-shadow: 0 22px 46px rgba(15, 23, 42, 0.22);
  }

  .form[hidden] {
    display: none;
  }

  .form label {
    display: grid;
    gap: 7px;
  }

  .form label span {
    font-size: 15px;
    font-weight: 600;
    color: var(--color-ink);
  }

  .form input,
  .form select {
    width: 100%;
    min-height: 56px;
    border-radius: 999px;
    border: 1.5px solid #e2e8f0;
    background: var(--color-bg);
    padding: 0 20px;
    font-size: 17px;
    color: var(--color-ink);
  }

  .form select {
    appearance: none;
  }

  .form input:focus,
  .form select:focus {
    border-color: var(--color-accent);
    background: #fff;
    outline: 3px solid rgba(234, 88, 12, 0.2);
  }

  .error {
    margin: 0;
    background: var(--color-danger-bg);
    color: var(--color-danger-dark);
    font-size: 15px;
    font-weight: 600;
    padding: 13px 18px;
    border-radius: 18px;
  }

  .submit {
    background: var(--color-accent);
    color: #fff;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 20px;
    letter-spacing: -0.3px;
    min-height: 64px;
    border: none;
    border-radius: 999px;
    cursor: pointer;
    box-shadow: 0 14px 30px rgba(234, 88, 12, 0.36);
  }

  .submit:hover {
    background: var(--color-accent-dark);
  }

  .disclaimer {
    margin: 0;
    font-size: 13.5px;
    color: var(--color-muted-2);
    text-align: center;
  }
</style>

<script>
  const form = document.getElementById("signup-form") as HTMLFormElement | null;
  const successCard = document.getElementById("success-card");
  const errorEl = document.getElementById("form-error");
  const successMessage = document.getElementById("success-message");
  const resetButton = document.getElementById("reset-form");

  function showError(message: string) {
    if (!errorEl) return;
    errorEl.textContent = message;
    errorEl.hidden = false;
  }

  function clearError() {
    if (!errorEl) return;
    errorEl.hidden = true;
    errorEl.textContent = "";
  }

  form?.addEventListener("submit", (event) => {
    event.preventDefault();
    clearError();

    const data = new FormData(form);
    const name = String(data.get("name") ?? "").trim();
    const email = String(data.get("email") ?? "").trim();
    const zone = String(data.get("zone") ?? "").trim();

    if (!name) return showError("Escribe tu nombre para continuar.");
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) return showError("Revisa tu correo: parece incompleto.");
    if (!zone) return showError("Selecciona la localidad donde haces entregas.");

    if (successMessage) {
      successMessage.textContent = `Te avisamos en cuanto el piloto llegue a ${zone}.`;
    }

    form.hidden = true;
    if (successCard) successCard.hidden = false;
  });

  resetButton?.addEventListener("click", () => {
    form?.reset();
    clearError();
    if (form) form.hidden = false;
    if (successCard) successCard.hidden = true;
  });
</script>
