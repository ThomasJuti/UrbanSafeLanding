---
const navLinks = [
  { href: "#reto", label: "El reto" },
  { href: "#solucion", label: "Solución" },
  { href: "#equipo", label: "Equipo" },
];
---

<header class="site-header">
  <div class="container">
    <div class="bar">
      <a href="#top" class="brand">
        <span class="brand-mark" aria-hidden="true">
          <svg width="19" height="19" viewBox="0 0 24 24" fill="none">
            <path
              d="M12 21s7-6.1 7-11a7 7 0 1 0-14 0c0 4.9 7 11 7 11Z"
              stroke="#fff"
              stroke-width="2"
              stroke-linejoin="round"></path>
            <circle cx="12" cy="10" r="2.4" fill="#fff"></circle>
          </svg>
        </span>
        <span class="brand-name">UrbanSafe</span>
      </a>

      <nav class="nav-desktop" aria-label="Navegación principal">
        {navLinks.map((link) => <a href={link.href}>{link.label}</a>)}
      </nav>

      <a href="#registro" class="cta">Registrarme</a>

      <button
        type="button"
        class="menu-toggle"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="mobile-nav"
        id="menu-toggle"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true">
          <path
            d="M4 7h16M4 12h16M4 17h16"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"></path>
        </svg>
      </button>
    </div>
  </div>

  <div class="mobile-nav-wrap">
    <nav id="mobile-nav" class="mobile-nav" aria-label="Navegación móvil" hidden>
      {navLinks.map((link) => <a href={link.href}>{link.label}</a>)}
      <a href="#registro" class="mobile-cta">Probar el prototipo</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 60;
    background: rgba(248, 250, 252, 0.9);
    backdrop-filter: blur(14px);
  }

  .bar {
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: 8px 10px 8px 16px;
    margin-block: 14px;
    display: flex;
    align-items: center;
    gap: 14px;
    box-shadow: 0 8px 24px rgba(15, 23, 42, 0.07);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--color-ink);
    margin-right: auto;
  }

  .brand-mark {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: var(--color-accent);
    display: grid;
    place-items: center;
    flex: 0 0 auto;
  }

  .brand-name {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 20px;
    letter-spacing: -0.5px;
  }

  .nav-desktop {
    display: none;
    align-items: center;
    gap: 22px;
    padding-right: 6px;
  }

  .nav-desktop a {
    color: var(--color-muted);
    font-size: 15.5px;
    font-weight: 500;
  }

  .nav-desktop a:hover {
    color: var(--color-ink);
  }

  .cta {
    background: var(--color-accent);
    color: #fff;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 15.5px;
    padding: 13px 22px;
    border-radius: 999px;
    min-height: 46px;
    display: inline-flex;
    align-items: center;
    box-shadow: 0 8px 20px rgba(234, 88, 12, 0.34);
  }

  .cta:hover {
    background: var(--color-accent-dark);
    color: #fff;
  }

  .menu-toggle {
    width: 46px;
    height: 46px;
    border-radius: 50%;
    border: 1px solid var(--color-border);
    background: var(--color-bg);
    color: var(--color-ink);
    display: grid;
    place-items: center;
    cursor: pointer;
    flex: 0 0 auto;
  }

  .menu-toggle:hover {
    background: var(--color-surface-alt);
  }

  .mobile-nav-wrap {
    padding: 0 20px 14px;
  }

  .mobile-nav {
    max-width: var(--max-width);
    margin: 0 auto;
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: 24px;
    padding: 10px 18px;
    display: grid;
    gap: 2px;
    box-shadow: 0 14px 34px rgba(15, 23, 42, 0.12);
  }

  .mobile-nav[hidden] {
    display: none;
  }

  .mobile-nav a {
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: 18px;
    font-weight: 600;
    padding: 14px 2px;
    border-bottom: 1px solid #f1f5f9;
  }

  .mobile-nav .mobile-cta {
    color: var(--color-accent-dark);
    font-weight: 700;
    border-bottom: none;
  }

  @media (min-width: 860px) {
    .nav-desktop {
      display: flex;
    }

    .menu-toggle {
      display: none;
    }

    .mobile-nav-wrap {
      display: none;
    }
  }
</style>

<script>
  const toggle = document.getElementById("menu-toggle");
  const mobileNav = document.getElementById("mobile-nav");

  if (toggle && mobileNav) {
    toggle.addEventListener("click", () => {
      const isOpen = !mobileNav.hidden;
      mobileNav.hidden = isOpen;
      toggle.setAttribute("aria-expanded", String(!isOpen));
    });

    mobileNav.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => {
        mobileNav.hidden = true;
        toggle.setAttribute("aria-expanded", "false");
      });
    });
  }
</script>
