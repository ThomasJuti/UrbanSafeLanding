---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Challenge from "../components/Challenge.astro";
import Solution from "../components/Solution.astro";
import Team from "../components/Team.astro";
import SignupForm from "../components/SignupForm.astro";
import Footer from "../components/Footer.astro";
---

<Layout
  title="UrbanSafe — Rutas y zonas de entrega seguras en Bogotá"
  description="Mira el riesgo de cada barrio antes de aceptar el pedido, recibe alertas antes de entrar a una zona caliente y llega con una ruta alterna lista. Piloto abierto en Bogotá."
>
  <div class="page">
    <Header />
    <main>
      <Hero />
      <Challenge />
      <Solution />
      <Team />
      <SignupForm />
    </main>
    <Footer />
  </div>
</Layout>

<style>
  .page {
    min-height: 100vh;
    overflow-x: hidden;
  }
</style>
